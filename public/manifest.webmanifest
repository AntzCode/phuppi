{
    "name": "Phuppi",
    "short_name": "Phuppi",
    "description": "Upload and share files",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "background_color": "#ffffff",
    "theme_color": "#504024",
    "icons": [
        { "src": "/assets/images/logo/phuppi/phuppi-icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/assets/images/logo/phuppi/phuppi-icon-512.png", "sizes": "512x512", "type": "image/png" }
    ],
    "share_target": {
        "action": "/share-target",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "files": [
                { "name": "files", "accept": ["image/*", "video/*", "audio/*", "application/*", "text/*", "*/*"] }
            ]
        }
    }
}
