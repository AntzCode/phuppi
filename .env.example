# Phuppi Environment Configuration
# Copy this file to .env and uncomment/adjust values as needed.
#
# Paths can be overridden here. If not set, defaults to:
# - views: src/views
# - root: project root (location of this file)
# - data: root/data
# - public: root/public if it exists, otherwise root/html
# - cache: data/cache
#
# PHUPPI_ROOT_PATH=/custom/project/root
# PHUPPI_VIEWS_PATH=/custom/views/path
# PHUPPI_DATA_PATH=/custom/data/path
# PHUPPI_PUBLIC_PATH=/custom/public/path
# PHUPPI_CACHE_PATH=/custom/cache/path

# S3-compatible dev storage (Garage). The access key must be "GK" + 24 hex characters and the
# secret 64 hex characters, because Garage validates the format.
S3_DEV_ENDPOINT=http://localhost:3900
S3_DEV_ACCESS_KEY=GKa1b2c3d4e5f6a7b8c9d0e1f2
S3_DEV_SECRET_KEY=6f0e4b1c9d2a7385e1f4c6b0a93d7e28b5c1f04a69d3e7820b4c5a1f6e9d3b07
S3_DEV_BUCKET=phuppi-files
S3_DEV_PATH_PREFIX=data/uploadedFiles
# Address browsers use for presigned URLs. "request" (default) = the HTTPS origin the page was opened on
# (through the Caddy proxy). Set a full URL to override, or leave "request" and open the app over HTTPS.
# S3_DEV_PUBLIC_ENDPOINT=request

# Names or IPs devices use to reach this machine over HTTPS (Caddy certificate names), comma separated
# DEV_HOSTS=localhost, 192.168.1.20
# The LAN IP devices open directly (browsers send no server name for an IP address)
# DEV_DEFAULT_HOST=192.168.1.20

# Database Configuration
# Add other environment variables as needed